<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirm Order</title>

    <link rel="icon" href="images/ice-cream-cone-icon.webp">
</head>
<body>
    <h1>Thank you for your order, <%= order.name%></h1>
    <h2>Order Details</h2>
    <p>Name: <%= order.name%></p> 
    <P>Email: <%= order.email%> </P>
    <p>Flavor: <%= order.flavor%></p>
    <P>Cone: <%= order.cone%> </P>
    <p>Topping: <%= order.toppings%></p>
    <p>Comment: <%= order.comment%></p>

    <a href="/">Place your next order</a>
</body>
</html>